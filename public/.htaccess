# ----------------------------------------------------------------------
# Drive North Cyprus - cPanel Apache Configuration (.htaccess)
# ----------------------------------------------------------------------

# 1. Correct MIME Types (Critical for Favicons and Web Manifest)
<IfModule mod_mime.c>
  AddType image/x-icon .ico
  AddType image/png .png
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest .json
  AddType text/x-component .txt
</IfModule>

# 2. Public Access & Caching for Search Engines & Favicons
<FilesMatch "\.(ico|png|svg|webmanifest)$">
  <IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </IfModule>
</FilesMatch>

# 3. Never Block Googlebot-Image or Search Engine Crawlers
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_USER_AGENT} (Googlebot|Googlebot-Image|bingbot|DuckDuckBot|Baiduspider|YandexBot) [NC]
  RewriteRule .*\.(ico|png|jpe?g|svg)$ - [L]
</IfModule>

# 4. Next.js Static Export Clean URLs Routing (Fixes 404 on Refresh in cPanel)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing static files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If an HTML file exists for the route (e.g. /routes -> /routes.html), rewrite to it
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)/?$ $1.html [L]

  # Fallback to Next.js 404 page
  ErrorDocument 404 /_not-found.html
</IfModule>
